{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "cds watch (local)",
      "request": "launch",
      "type": "node",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/cds",
      "runtimeArgs": ["watch"],
      "args": [],
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    }
  ]
}
