{
	"name": "btp-devsecops-demo",
	"version": "0.0.1",
	"description": "Demo CAP app for AD107102 — Security and Compliance on BTP",
	"scripts": {
		"start": "cds-serve",
		"dev": "cds watch",
		"test": "echo 'No unit tests in demo' && exit 0",
		"start-claude": "start-claude"
	},
	"dependencies": {
		"@sap/cds": "^10.1.1",
		"@sap/xssec": "^4",
		"@cap-js/sqlite": "^3.1.2",
		"express": "^4.18.2"
	},
	"devDependencies": {
		"@sap/cds-dk": "*",
		"@sap/dev-cap-tools": "^1.31.0"
	},
	"cds": {
		"requires": {
			"db": {
				"kind": "sqlite"
			}
		}
	},
	"engines": {
		"node": ">=18"
	},
	"allowScripts": {
		"sqlite3": true,
		"@sap/hana-client": true
	}
}
